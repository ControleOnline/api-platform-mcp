{
    "name": "controleonline/mcp",
    "description": "Model Context Protocol (MCP) integration for ControleOnline API — read-only tools for AI agents",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ControleOnline\\": "src/",
            "ControleOnline\\Repository\\": "src/Repository/",
            "ControleOnline\\Entity\\": "src/Entity/",
            "ControleOnline\\Controller\\": "src/Controller/",
            "ControleOnline\\Service\\": "src/Service/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ControleOnline\\Mcp\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Controle Online",
            "email": "luiz.kim@controleonline.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "controleonline/common": "1.0.4",
        "controleonline/people": "1.0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    }
}
